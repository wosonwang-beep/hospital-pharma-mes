# Local development only. Copy to .env and replace every sample secret.
MES_DB_NAME=hospital_pharma_mes_dev
MES_DB_PORT=3306
MES_DB_USERNAME=mes
MES_DB_PASSWORD=mes_local_password
MES_DB_ROOT_PASSWORD=root_local_password
MES_DB_URL=jdbc:mariadb://localhost:3306/hospital_pharma_mes_dev
MES_REDIS_HOST=localhost
MES_REDIS_PORT=6379
MES_REDIS_PASSWORD=redis_local_password
MES_MINIO_ENDPOINT=http://localhost:9000
MES_MINIO_API_PORT=9000
MES_MINIO_CONSOLE_PORT=9001
MES_MINIO_ACCESS_KEY=minioadmin
MES_MINIO_SECRET_KEY=minioadmin_local_password
MES_MINIO_LICENSE_FILE=./deploy/docker/minio.license
