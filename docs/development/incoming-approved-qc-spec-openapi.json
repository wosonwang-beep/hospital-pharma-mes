  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "QcSpecificationIfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\"(0|[1-9][0-9]*)\"$"
        },
        "description": "Quoted current versionNo; must equal body versionNo."
      }
    },
    "schemas": {
      "SpecificationItemInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "itemCode": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "itemName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "resultType": {
            "type": "string",
            "enum": [
              "NUMERIC",
              "TEXT"
            ]
          },
          "lowerLimit": {
            "type": "string",
            "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,6})?$",
            "description": "Exact DECIMAL(18,6), no precision truncation; canonical snapshots use six fractional digits.",
            "nullable": true
          },
