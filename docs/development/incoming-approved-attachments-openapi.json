  "components": {
    "schemas": {
      "AttachmentMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fileName",
          "mediaType",
          "byteLength",
          "sha256",
          "uploadedBy",
          "uploadedAt",
          "recordVersion",
          "retentionStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "fileName": {
            "type": "string",
            "maxLength": 255
          },
          "mediaType": {
            "type": "string",
            "maxLength": 127
          },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uploadedBy": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "retentionStatus": {
            "type": "string",
            "enum": [
              "RETAINED"
            ]
          }
        }
      },
      "ReceiptAttachmentLink": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "versionNo",
          "attachmentId",
          "purpose",
          "reason"
        ],
        "properties": {
          "versionNo": {
            "type": "integer",
            "minimum": 0
          },
          "attachmentId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "COA",
              "DELIVERY_DOCUMENT",
              "OTHER"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "ReceiptAttachment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "receiptId",
          "purpose",
          "reason",
          "linkedBy",
          "linkedAt",
          "recordVersion",
          "attachment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "receiptId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "COA",
              "DELIVERY_DOCUMENT",
              "OTHER"
            ]
          },
          "reason": {
            "type": "string"
          },
          "linkedBy": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "linkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "attachment": {
            "$ref": "#/components/schemas/AttachmentMetadata"
          }
        }
      },
      "ApiAttachmentMetadata": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "traceId"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/AttachmentMetadata"
          },
          "traceId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "OK"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiReceiptAttachment": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "traceId"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReceiptAttachment"
          },
          "traceId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "OK"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ApiReceiptAttachments": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data",
          "traceId"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptAttachment"
            }
          },
          "traceId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "OK"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
