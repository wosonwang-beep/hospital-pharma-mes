  "components": {
    "schemas": {
      "RuntimeValueInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fieldCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "occurrencePath": {
            "type": "string",
            "maxLength": 255
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "nullable": true,
            "description": "Exact numeric values are decimal strings. MULTI_ENUM uses string arrays; null is an explicit missing-value revision."
          },
          "unitId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "nullable": true
          },
          "sourceRef": {
            "type": "string",
            "maxLength": 128,
            "nullable": true
          }
        },
        "required": [
          "fieldCode",
          "occurrencePath",
          "value",
          "unitId",
          "sourceRef"
        ]
      },
      "SaveRuntimeValues": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formRevision": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuntimeValueInput"
            }
          }
        },
        "required": [
          "formRevision",
          "reason",
          "values"
        ]
      },
      "RuntimeFormCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formRevision": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "formRevision",
          "reason"
        ]
      },
      "CorrectRuntimeValue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formRevision": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "newValue": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "nullable": true,
            "description": "Exact numeric values are decimal strings. MULTI_ENUM uses string arrays; null is an explicit missing-value revision."
          }
        },
        "required": [
          "formRevision",
          "reason",
          "newValue"
        ]
      },
      "ReviewRuntimeForm": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formRevision": {
            "type": "integer",
            "minimum": 0
          },
          "reviewRuleId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "PASS",
              "REJECT"
            ]
          },
          "comment": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "reauthToken": {
            "type": "string",
            "minLength": 1,
            "writeOnly": true
          }
        },
        "required": [
          "formRevision",
          "reviewRuleId",
          "decision",
          "comment",
          "reason",
          "reauthToken"
        ]
      },
      "FormRuntimeSummary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "operationExecutionId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "formDefId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "formCode": {
            "type": "string"
          },
          "formName": {
            "type": "string"
          },
          "occurrenceNo": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED",
