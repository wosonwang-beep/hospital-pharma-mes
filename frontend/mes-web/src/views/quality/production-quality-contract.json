{
  "schemas": {
    "BalanceInvestigateCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versionNo": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "investigationText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "versionNo",
        "reason",
        "investigationText"
      ]
    },
    "BalanceInvestigationCreateCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versionNo": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "investigationText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "versionNo",
        "reason",
        "investigationText"
      ]
    },
    "ProductionTestReviewCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "versionNo": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "signature": {
          "$ref": "#/components/schemas/ControlledActionSignature"
        },
        "resultRevisionId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "CONFIRMED",
            "INVALIDATED"
          ]
        }
      },
      "required": [
        "versionNo",
        "reason",
        "signature",
        "resultRevisionId",
        "disposition"
      ]
    },
    "ControlledActionSignature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reauthToken": {
          "type": "string"
        }
      },
      "required": [
        "reauthToken"
      ]
    },
    "ProductionPlanUpdateCommand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mainBatchId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "finishedMaterialId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "qcSpecificationVersionId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "balanceRules": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/components/schemas/ProductionBalanceDefinition"
          },
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "versionNo": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mainBatchId",
        "finishedMaterialId",
        "qcSpecificationVersionId",
        "balanceRules",
        "reason",
        "versionNo"
      ]
    },
    "ProductionBalanceDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "balanceCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "basis": {
          "type": "string",
          "enum": [
            "BATCH",
            "OPERATION",
            "PACKAGING"
          ]
        },
        "operationCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "nullable": true
        },
        "materialId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "nullable": true
        },
        "unitId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "formulaExpr": {
          "$ref": "#/components/schemas/BalanceFormula"
        },
        "toleranceLow": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]{0,15})(?:\\.[0-9]{1,8})?$"
        },
        "toleranceHigh": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]{0,15})(?:\\.[0-9]{1,8})?$"
        },
        "checkPoint": {
          "type": "string",
          "enum": [
            "OPERATION_COMPLETE",
            "BATCH_COMPLETE",
            "QA_RELEASE"
          ]
        }
      },
      "required": [
        "balanceCode",
        "basis",
        "unitId",
        "formulaExpr",
        "toleranceLow",
        "toleranceHigh",
        "checkPoint"
      ]
    },
    "BalanceFormula": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dslVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "expected": {
          "$ref": "#/components/schemas/BalanceExpression"
        },
        "actual": {
          "$ref": "#/components/schemas/BalanceExpression"
        },
        "metric": {
          "type": "string",
          "enum": [
            "DIFFERENCE_PCT",
            "YIELD_PCT"
          ]
        }
      },
      "required": [
        "dslVersion",
        "expected",
        "actual",
        "metric"
      ]
    },
    "BalanceExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sum": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "string",
                "enum": [
                  "CHARGE",
                  "ISSUE",
                  "RETURN",
                  "OUTPUT",
                  "SAMPLE",
                  "LOSS",
                  "SCRAP",
                  "WIP"
                ]
              }
            }
          },
          "required": [
            "sum"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "constant": {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]{0,23})(?:\\.[0-9]{1,8})?$"
            }
          },
          "required": [
            "constant"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "ADD",
                "SUBTRACT",
                "MULTIPLY",
                "DIVIDE"
              ]
            },
            "left": {
              "$ref": "#/components/schemas/BalanceExpression"
            },
            "right": {
              "$ref": "#/components/schemas/BalanceExpression"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ]
        }
      ]
    },
    "ProductionDeviationCreateCommand": {
      "type": "object",
