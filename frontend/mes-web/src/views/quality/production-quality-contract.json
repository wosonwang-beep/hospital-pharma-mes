        },
        "severity": {
          "type": "string",
          "enum": [
            "MINOR",
            "MAJOR",
            "CRITICAL"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "productionTestInstanceId": {
