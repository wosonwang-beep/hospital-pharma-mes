          "nullable": true
        },
        "originalResultRevisionId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "nullable": true
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "investigationScope",
        "mainBatchId",
        "investigationKind",
        "severity",
        "description",
        "reason"
      ]
