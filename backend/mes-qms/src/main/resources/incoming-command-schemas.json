        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "investigationSummary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "investigationScope": {
        "type": "string",
        "enum": [
          "INCOMING_MATERIAL"
        ]
      }
    },
    "required": [
      "description",
      "reason",
      "investigationScope"
    ]
  },
  "InvestigateCommand": {
    "type": "object",
