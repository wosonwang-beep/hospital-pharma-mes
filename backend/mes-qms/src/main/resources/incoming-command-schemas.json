      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "reauthToken": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "writeOnly": true
      },
      "investigationScope": {
        "type": "string",
        "enum": [
          "INCOMING_MATERIAL"
        ]
      }
    },
    "required": [
      "decisionCode",
      "disposition",
      "reauthToken",
      "reason",
      "investigationScope"
    ]
  },
  "CloseDeviationCommand": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "selectedResultRevisionId": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "originalResultDisposition": {
        "type": "string",
        "enum": [
          "VALID",
          "INVALID"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "reauthToken": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "writeOnly": true
      },
      "investigationScope": {
        "type": "string",
        "enum": [
          "INCOMING_MATERIAL"
        ]
      }
    },
    "required": [
